{
  "$schema": "http://json-schema.org/draft-04/schema",
  "description": "Schema for SM get_categories response - list of message category types",
  "type": "object",
  "required": ["data"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_category_type"],
      "properties": {
        "message_category_type": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "errors": {
      "type": ["object", "null"]
    }
  }
}
