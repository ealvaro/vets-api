{
  "form1[0].#subform[0].NameofVeteran[0]": "<%= form.name_for_pdf %>",
  "form1[0].#subform[0].SSN[0]": "<%= form.last_four_ssn %>",
  "form1[0].#subform[0].ADDRESS[0]": "<%= form.full_address %>",
  "form1[0].#subform[0].Phone2[0]": "<%= form.data['phone'] || '' %>",
  <% form.appliances_for_pdf.each_with_index do |app, i| %>
    <% num = i + 1 %>
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].#subform[0].SERVICE-CONNECTEDDISABILITY1[0]": "<%= app[:disability] %>",
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].NAMEOFDEVICEORTHOPEDICAPPLIANCEORSKINMEDICATION1[0]": "<%= app[:device] %>",
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].#subform[1].UPPER\\.LOWER<%= num %>[0]": <%= form.data_massage(app[:upper_or_lower][:upper]) %>,
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].#subform[1].RadioButtonList[0]": "<%= app[:upper_or_lower][:upper_side] %>",
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].#subform[2].UPPER\\.LOWER<%= num %>[1]": <%= form.data_massage(app[:upper_or_lower][:lower]) %>,
    "form1[0].#subform[0].Table1[0].Row<%= num %>[0].#subform[2].RadioButtonList[1]": "<%= app[:upper_or_lower][:lower_side] %>",
  <% end %>

  "form1[0].#subform[0].Elect[0]": "<%= form.data['electTermination'] || '' %>",
  "form1[0].#subform[0].Signature1[0]": "<%= form.signature %>",
  "form1[0].#subform[0].Date[0]": "<%= form.signature_date.strftime('%m/%d/%Y')%>"
}