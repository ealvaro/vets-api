<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page_title %> | Veterans Affairs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Source Sans Pro Web", "Source Sans Pro", "Helvetica Neue", Helvetica, Arial, sans;
      font-size: 1.06rem;
      line-height: 1.5;
      color: #1b1b1b;
      background: #ffffff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .va-header {
      background-color: #162e51;
    }

    .va-header__inner {
      max-width: 1000px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
    }



    .main-content {
      flex: 1;
      max-width: 1000px;
      margin: 0 auto;
      width: 100%;
      padding: 40px 24px 80px;
    }

    h1, h2 {
      font-family: Bitter, Georgia, Cambria, "Times New Roman", Times, serif;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: .5em;
      margin-top: 1.5em;
      color: #1b1b1b;
    }

    h1 {
      font-size: 2.5rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    p, a {
      font-family: "Source Sans Pro Web", "Source Sans Pro", "Helvetica Neue", Helvetica, Arial, sans;
      font-size: 1.06rem;
      line-height: 1.5;
    }

    p {
      margin-top: 1em;
      margin-bottom: 1em;
    }

    .va-alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background-color: #f4e3db;
      border-left: 8px solid #d54309;
      padding: 16px 20px;
      margin-bottom: 8px;
      max-width: 740px;
    }

    .va-alert__icon {
      flex-shrink: 0;
      margin-top: 2px;
    }

    .va-alert__icon svg {
      width: 22px;
      height: 22px;
      fill: #1b1b1b;
    }

    .va-alert__text {
      font-size: 1.06rem;
      line-height: 1.5;
      margin: 0;
    }

    a {
      color: #005ea2;
      text-decoration: underline;
    }

    a:hover {
      color: #1a4480;
    }

    .va-links {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-bottom: 20px;
    }

    .va-links a {
      display: block;
      font-size: 1.06rem;
      line-height: 1.8;
    }

    .error-meta {
      font-style: italic;
      font-size: 1.06rem;
      line-height: 1.9;
      margin-top: 28px;
    }

    .error-meta span {
      display: block;
    }

    .usa-button {
      display: block;
      width: fit-content;
      background-color: #005ea2;
      color: white;
      font-family: "Source Sans Pro Web", "Source Sans Pro", "Helvetica Neue", Helvetica, Arial, sans;
      font-size: 1.06rem;
      font-weight: 700;
      line-height: 1.35;
      padding: 0.6rem 1.25rem;
      text-decoration: none;
      white-space: nowrap;
      border: 0;
      border-radius: 0.25rem;
      margin-top: 1em;
      margin-bottom: 1em;
    }

    .usa-button:hover {
      background-color: #1a4480;
      color: white;
      text-decoration: none;
    }

    .va-footer {
      background-color: #162e51;
      padding: 80px 24px;
    }

    @media (max-width: 481px) {
      h1 { font-size: 1.875rem; }
    }

    @media (max-width: 600px) {
      .main-content { padding: 24px 16px 60px; }
    }
  </style>
</head>
<body>

  <header class="va-header" role="banner">
    <div class="va-header__inner">
      <a href="<%= home_uri %>" aria-label="VA logo">
        <img src="https://s3-us-gov-west-1.amazonaws.com/content.www.va.gov/img/header-logo.png" alt="VA logo and Seal, U.S. Department of Veterans Affairs" height="59" width="264">
      </a>
    </div>
  </header>

  <main class="main-content" id="main-content">

    <h1>We can't sign you in</h1>

    <div class="va-alert" role="alert">
      <div class="va-alert__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
        </svg>
      </div>
      <p class="va-alert__text"><%= alert_text %></p>
    </div>

    <h2><%= section_title %></h2>

    <% if intro_text %>
      <p><%= sanitize(intro_text, tags: %w[a strong br], attributes: %w[href]) %></p>
    <% end %>

    <% if secondary_section_title %>
      <h2><%= secondary_section_title %></h2>
      <% if secondary_intro_text %>
        <p><%= sanitize(secondary_intro_text, tags: %w[a strong br], attributes: %w[href]) %></p>
      <% end %>
    <% end %>

    <div class="va-links">
      <a href="https://www.va.gov/resources/va-customer-service-phone-numbers/">Get a list of helpful VA phone numbers</a>
      <a href="https://www.va.gov/find-locations/">Find a VA location near you</a>
    </div>

    <% if redirect_uri %>
      <a href="<%= redirect_uri %>" class="usa-button">
        Try signing in again
      </a>
    <% else %>
      <p><strong>Try signing in again</strong></p>
    <% end %>

    <div class="error-meta" aria-label="Error details">
      <span>Error code: <%= error_code %></span>
      <span>Request ID: <%= request_id %></span>
      <span><%= timestamp %></span>
    </div>

  </main>

  <footer class="va-footer" role="contentinfo" aria-label="Footer"></footer>

</body>
</html>
